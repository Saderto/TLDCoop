<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SmokehouseBySeagull</AssemblyName>
    <RootNamespace>SmokehouseBySeagull</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS0436;CS8618;CS8625;CS8600;CS8602;CS8603;CS8604;CS8632</NoWarn>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RefsDir Condition="'$(RefsDir)' == ''">..\..\shotgun\refs-2.59</RefsDir>
  </PropertyGroup>
  <!-- Built against the game's own assemblies; nothing is copied next to the game. State is a JSON file per world (System.Text.Json). -->
  <ItemGroup>
    <Reference Include="$(RefsDir)\*.dll" Private="false" />
    <Reference Include="..\..\smokes\refs-extra\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="..\..\smokes\refs-extra\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Il2Cpp" />
    <Using Include="Il2CppTLD.Gear" />
    <Using Include="Il2CppTLD.IntBackedUnit" />
    <Using Include="HarmonyLib" />
    <Using Include="MelonLoader" />
    <Using Include="UnityEngine" />
  </ItemGroup>
</Project>
