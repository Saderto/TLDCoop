<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>TrainerByEMPEROR</AssemblyName>
    <RootNamespace>TrainerByEMPEROR</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Сборки игры и MelonLoader 0.7.2 (MelonLoader.dll, 0Harmony, Il2CppInterop из архива 0.7.2) лежат в одной папке.
         Game assemblies and MelonLoader 0.7.2 libraries in one folder; pass -p:RefsDir=... to use another one. -->
    <RefsDir Condition="'$(RefsDir)' == ''">..\refs-2.58</RefsDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(RefsDir)\*.dll" Private="false" />
    <Compile Include="..\Shared\Features.cs" Link="Shared\Features.cs" />
    <Compile Include="..\Shared\L.cs" Link="Shared\L.cs" />
  </ItemGroup>

</Project>
