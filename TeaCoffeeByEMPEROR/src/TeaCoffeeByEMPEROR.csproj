<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>TeaCoffeeByEMPEROR</AssemblyName>
    <RootNamespace>TeaCoffeeByEMPEROR</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS0436;CS8618;CS8625;CS8600;CS8602;CS8603;CS8604;CS8632</NoWarn>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>..\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RefsDir Condition="'$(RefsDir)' == ''">../refs</RefsDir>
  </PropertyGroup>
  <!-- Built against the game's own assemblies; nothing is copied next to the game. -->
  <ItemGroup>
    <Reference Include="$(RefsDir)\*.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\fx\fx_*.png" LogicalName="TeaCoffeeByEMPEROR.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Il2Cpp" />
    <Using Include="Il2CppTLD.Gear" />
    <Using Include="Il2CppTLD.IntBackedUnit" />
    <Using Include="HarmonyLib" />
    <Using Include="MelonLoader" />
    <Using Include="UnityEngine" />
  </ItemGroup>
</Project>
